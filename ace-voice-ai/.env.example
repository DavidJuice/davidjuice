# Google (Calendar + TTS)
# Paste the entire service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CALENDAR_ID=primary

# Server
PORT=8080
BASE_URL=https://ace-voice-ai-xxxx-uw.a.run.app
# Protects the /trigger/outbound-call endpoint — set a strong random string
TRIGGER_SECRET=change-me-in-production
