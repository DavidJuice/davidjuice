# Branch phone for transfer
ACE_BRANCH_PHONE_NUMBER=+12065550199

# Deepgram
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-xxxx

# Naver Clova TTS (Korean)
