        "election_code":          { "columns": ["Election Code"], "transform": "trim" },
        "plan_year":              { "columns": ["PlanYear"], "transform": "trim" },
        "agent_npn":              { "columns": ["NPN"], "transform": "trim" },
        "application_source":     { "columns": ["Application Source"], "transform": "trim" },
        "application_id":         { "columns": ["Application ID"], "transform": "trim" },
