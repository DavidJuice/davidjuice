        "low_income_subsidy":     { "columns": ["Low Income Subsidy"], "transform": "trim" },
        "status":                 { "columns": ["Status"], "transform": "uppercase" },
        "status_date":            { "columns": ["Status Date"], "type": "date" },
        "status_description":     { "columns": ["Status Description"], "transform": "trim" },
        "effective_date":         { "columns": ["Effective Date"], "type": "date" },
