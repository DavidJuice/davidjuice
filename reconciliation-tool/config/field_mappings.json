        "servicing_agent":        { "columns": ["Servicing Agent Name"], "transform": "trim" },
        "agent_of_record":        { "columns": ["Servicing Agent Name", "Signing Agent Name"], "transform": "trim" },
        "enrollment_type":        { "columns": ["Enrollment Type"], "transform": "trim" },
        "renewal_confirmation":   { "columns": ["Renewal Confirmation"], "transform": "trim" },
        "enrollment_period":      { "columns": ["Enrollment Period"], "transform": "trim" },
        "aor_effective_date":     { "columns": ["AOR Effective Date"], "type": "date" },
        "medicaid_level":         { "columns": ["Medicaid Level"], "transform": "trim" },
        "policy_holder_status":   { "columns": ["Policy Holder Status"], "transform": "uppercase" },
