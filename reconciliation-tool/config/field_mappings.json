        "pc_edge_plan_id":        { "columns": ["PlanCompare Edge for Agents Plan ID"], "transform": "trim" },
        "carrier_2":              { "columns": ["Carrier Name 2"], "transform": "trim" },
        "coverage_type_2":        { "columns": ["Coverage Type 2"], "transform": "trim" },
        "plan_name":              { "columns": ["Product Name"], "transform": "trim" },
        "product_effective_date": { "columns": ["Product Effective Date"], "type": "date" },
        "product_term_date":      { "columns": ["Product Term Date"], "type": "date" },
        "provider_network":       { "columns": ["Provider Network"], "transform": "trim" },
        "primary_care_provider":  { "columns": ["Primary Care Provider"], "transform": "trim" },
        "primary_care_provider_id": { "columns": ["Primary Care Provider ID"], "transform": "trim" }
