{
  "version": 2,
  "sources": {
    "ab_individual": {
      "label": "AgencyBloc Individual Report",
      "header_required": ["First Name", "Last Name", "Birth Date"],
      "mbi_required": true,
      "fields": {
        "individual_id":      { "columns": ["Individual ID"], "transform": "trim" },
        "group_name":         { "columns": ["Group Name"], "transform": "trim" },
        "carrier":            { "columns": ["Carrier Name"], "transform": "trim" },
        "carrier_normalized": { "columns": ["Carrier Name"], "transform": "normalize_carrier" },
        "first_name":         { "columns": ["First Name"], "transform": "trim" },
        "middle_name":        { "columns": ["Middle Name"], "transform": "trim" },
        "last_name":          { "columns": ["Last Name"], "transform": "trim" },
        "nickname":           { "columns": ["Nickname"], "transform": "trim" },
        "dob":                { "columns": ["Birth Date"], "type": "date" },
        "deceased_date":      { "columns": ["Deceased Date"], "type": "date" },
        "gender":             { "columns": ["Gender"], "transform": "trim" },
        "email":              { "columns": ["Email", "Secondary Email"], "transform": "trim" },
        "address":            { "columns": ["Primary Address"], "transform": "trim" },
        "address2":           { "columns": ["Primary Address 2"], "transform": "trim" },
        "zip":                { "columns": ["Primary Zip Code"], "transform": "trim" },
        "city":               { "columns": ["Primary City"], "transform": "trim" },
        "county":             { "columns": ["Primary County"], "transform": "trim" },
        "state":              { "columns": ["Primary State"], "transform": "trim" },
        "servicing_agent":    { "columns": ["Servicing Agent"], "transform": "trim" },
        "lead_agent":         { "columns": ["Lead Agent/Affiliate"], "transform": "trim" },
        "agent_of_record":    { "columns": ["Servicing Agent", "Lead Agent/Affiliate"], "transform": "trim" },
        "lead_date":          { "columns": ["Lead Date"], "type": "date" },
        "create_date":        { "columns": ["Create Date"], "type": "date" },
        "lead_source":        { "columns": ["Lead Source"], "transform": "trim" },
        "status":             { "columns": ["Individual Status"], "transform": "uppercase" },
        "individual_type":    { "columns": ["Individual Type"], "transform": "trim" },
        "phone_cellular":     { "columns": ["Cellular Phone Number"], "transform": "trim" },
        "phone_home":         { "columns": ["Home Phone Number"], "transform": "trim" },
        "phone_business":     { "columns": ["Business Phone Number"], "transform": "trim" },
        "ssn":                { "columns": ["SSN"], "transform": "trim" },
        "mbi":                { "columns": ["MBI"], "transform": "trim" },
        "medicare_eff_a":     { "columns": ["Medicare Effective Date Part A"], "type": "date" },
        "medicare_eff_b":     { "columns": ["Medicare Effective Date Part B"], "type": "date" },
        "member_id":          { "columns": ["Member ID (or WAHPF App ID)", "Member ID"], "transform": "trim" },
        "fitness_benefit_id": { "columns": ["Fitness Benefit ID"], "transform": "trim" },
        "medicaid_level":     { "columns": ["Medicaid Level (Current)"], "transform": "trim" },
        "medicaid_number":    { "columns": ["Medicaid ID"], "transform": "trim" },
        "country":            { "columns": ["Country/Region (Self-Identified)"], "transform": "trim" },
        "cancel_date":        { "columns": ["Cancel Date"], "type": "date" },
        "cancel_reason":      { "columns": ["Cancel Reason: Other"], "transform": "trim" },
        "primary_language":   { "columns": ["Primary Language"], "transform": "trim" },
        "marital_status":     { "columns": ["Marital Status"], "transform": "trim" },
        "preferred_contact":  { "columns": ["Preferred Contact Method"], "transform": "trim" },
        "plan_name":          { "columns": ["Insurance Plan"], "transform": "trim" }
      }
    },

    "ab_policy": {
      "label": "AgencyBloc Policy Report",
      "header_required": ["Policy Number"],
      "mbi_required": true,
      "fields": {
        "member_id":        { "columns": ["Member ID", "Subscriber ID"] },
        "policy_number":    { "columns": ["Policy Number", "Policy #", "Policy"] },
        "mbi":              { "columns": ["MBI", "Medicare Number"] },
        "medicaid_number":  { "columns": ["Medicaid Number", "Medicaid #", "Medicaid ID"] },
        "first_name":       { "columns": ["Insured First Name", "First Name"], "transform": "trim" },
        "middle_name":      { "columns": ["Middle Name", "Middle Initial", "MI"], "transform": "trim" },
        "last_name":        { "columns": ["Insured Last Name", "Last Name"], "transform": "trim" },
        "dob":              { "columns": ["DOB", "Date of Birth"], "type": "date" },
        "agent_of_record":  { "columns": ["Agent of Record", "Writing Agent", "AOR"], "transform": "trim" },
        "servicing_agent":  { "columns": ["Servicing Agent"], "transform": "trim" },
        "signed_by":        { "columns": ["Signed By", "Signing Agent"], "transform": "trim" },
        "effective_date":   { "columns": ["Effective Date", "Eff Date"], "type": "date" },
        "term_date":        { "columns": ["Term Date", "Termination Date"], "type": "date" },
        "app_submit_date":  { "columns": ["App Submit Date", "Application Submit Date", "Submit Date"], "type": "date" },
        "renewal_date":     { "columns": ["Renewal Date"], "type": "date" },
        "plan_name":        { "columns": ["Plan Name", "Plan", "Product"], "transform": "trim" },
        "insurance_plan":   { "columns": ["Insurance Plan", "Plan", "Plan Name", "Product"], "transform": "trim" },
        "plan_year":        { "columns": ["Plan Year"] },
        "status":           { "columns": ["Status", "Policy Status"], "transform": "uppercase" },
        "policy_type":      { "columns": ["Policy Type", "Type", "Product Type"], "transform": "trim" },
        "premium":          { "columns": ["Premium"], "type": "number" },
        "carrier":          { "columns": ["Carrier"], "transform": "trim" },
        "carrier_normalized": { "columns": ["Carrier"], "transform": "normalize_carrier" }
      }
    },

    "ab_customer": {
      "label": "AgencyBloc Customer Report",
      "header_required": ["First Name", "Last Name"],
      "mbi_required": true,
      "fields": {
        "member_id":        { "columns": ["Member ID", "Customer ID", "Subscriber ID"] },
        "mbi":              { "columns": ["MBI", "Medicare Number"] },
        "medicaid_number":  { "columns": ["Medicaid Number", "Medicaid #", "Medicaid ID"] },
        "first_name":       { "columns": ["First Name"], "transform": "trim" },
        "middle_name":      { "columns": ["Middle Name", "Middle Initial", "MI"], "transform": "trim" },
        "last_name":        { "columns": ["Last Name"], "transform": "trim" },
        "dob":              { "columns": ["DOB", "Date of Birth"], "type": "date" },
        "agent_of_record":  { "columns": ["Agent of Record", "Writing Agent", "AOR"], "transform": "trim" },
        "individual_type":  { "columns": ["Individual Type", "Contact Type", "Type"], "transform": "trim" },
        "status":           { "columns": ["Status"], "transform": "uppercase" }
      }
    },

    "uhc_bob": {
      "label": "United Healthcare Book of Business",
      "header_required": ["Subscriber ID"],
      "fields": {
        "member_id":        { "columns": ["Subscriber ID", "Member ID", "Subscriber Number"] },
        "policy_number":    { "columns": ["Contract Number", "Contract #", "Policy Number"] },
        "mbi":              { "columns": ["HICN/MBI", "MBI", "Medicare Number"] },
        "first_name":       { "columns": ["Member First Name", "First Name"], "transform": "trim" },
        "middle_name":      { "columns": ["Middle Name", "Middle Initial", "MI"], "transform": "trim" },
        "last_name":        { "columns": ["Member Last Name", "Last Name"], "transform": "trim" },
        "dob":              { "columns": ["Date of Birth", "DOB"], "type": "date" },
        "agent_of_record":  { "columns": ["Writing Agent", "Agent Name", "Producer Name"], "transform": "trim" },
        "effective_date":   { "columns": ["Plan Effective Date", "Effective Date"], "type": "date" },
        "term_date":        { "columns": ["Plan Term Date", "Termination Date"], "type": "date" },
        "plan_name":        { "columns": ["Plan Name", "Product Name"], "transform": "trim" },
        "plan_year":        { "columns": ["Plan Year"] },
        "status":           { "columns": ["Member Status", "Status"], "transform": "uppercase" },
        "premium":          { "columns": ["Premium Amount", "Premium"], "type": "number" },
        "carrier":          { "constant": "United Healthcare" },
        "carrier_normalized": { "constant": "uhc" }
      }
    },

    "humana_bob": {
      "label": "Humana Book of Business",
      "header_required": ["Policy Number", "Event Date"],
      "history": { "group_by": "policy_number", "latest_by": "event_date" },
      "fields": {
        "member_id":        { "columns": ["Member Number", "Subscriber ID"] },
        "policy_number":    { "columns": ["Policy Number", "Contract Number"] },
        "mbi":              { "columns": ["MBI", "Medicare ID"] },
        "first_name":       { "columns": ["First Name"], "transform": "trim" },
        "middle_name":      { "columns": ["Middle Name", "Middle Initial", "MI"], "transform": "trim" },
        "last_name":        { "columns": ["Last Name"], "transform": "trim" },
        "dob":              { "columns": ["Date of Birth", "DOB"], "type": "date" },
        "agent_of_record":  { "columns": ["Agent of Record", "Producer", "Writing Agent"], "transform": "trim" },
        "effective_date":   { "columns": ["Effective Date", "Coverage Start"], "type": "date" },
        "term_date":        { "columns": ["Termination Date", "Coverage End"], "type": "date" },
        "plan_name":        { "columns": ["Plan Description", "Plan Name"], "transform": "trim" },
        "plan_year":        { "columns": ["Plan Year"] },
        "status":           { "columns": ["Policy Status", "Status"], "transform": "uppercase" },
        "premium":          { "columns": ["Monthly Premium", "Premium"], "type": "number" },
        "event_date":       { "columns": ["Event Date", "Transaction Date", "Activity Date"], "type": "date" },
        "carrier":          { "columns": ["Carrier"], "constant_fallback": "Humana", "transform": "trim" },
        "carrier_normalized": { "columns": ["Carrier"], "constant_fallback": "humana", "transform": "normalize_carrier" }
      }
    }
  }
}
