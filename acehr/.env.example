# ---------------------------------------------------------------------------
# AceHR environment
# Copy to .env.local for local dev; set the same keys in Vercel for deploys.
# VITE_* keys are inlined into the browser bundle -- never put secrets there.
# ---------------------------------------------------------------------------

# Supabase -- Project Settings > API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Used by the Stripe webhook + invite endpoints.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe -- https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe price IDs (create the products/prices once, paste the price IDs here)
VITE_STRIPE_PRICE_STARTER=price_xxx_starter
VITE_STRIPE_PRICE_GROWTH=price_xxx_growth
VITE_STRIPE_PRICE_ENTERPRISE=price_xxx_enterprise

# Public base URL of the app (used for Stripe return URLs and invite links)
VITE_APP_URL=http://localhost:5173

# Resend -- https://resend.com/api-keys
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=AceHR <noreply@yourdomain.com>
