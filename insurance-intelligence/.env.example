# --- database -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance
STORAGE_DIR=./var/documents

# --- model providers ------------------------------------------------------
# mock | anthropic | openai.  mock is deterministic and needs no key.
LLM_PROVIDER=mock
EMBED_PROVIDER=mock

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_CHEAP_MODEL=claude-haiku-4-5-20251001
# LLM_CAPABLE_MODEL=claude-sonnet-5
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- product behavior -----------------------------------------------------
STRICT_EVIDENCE=1
MAX_UPLOAD_MB=50

# --- web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
