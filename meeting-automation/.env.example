# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Meeting URLs (fixed every week)
TEAMS_MEETING_URL=https://teams.microsoft.com/l/meetup-join/...
ZOOM_MEETING_URL=https://zoom.us/j/...

# Google Drive folder IDs
# Get these from the URL of each folder: drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID_9AM=your_9am_folder_id_here
GOOGLE_DRIVE_FOLDER_ID_2PM=your_2pm_folder_id_here

# Google Doc title format (strftime format codes apply, {time} = "9AM" or "2PM")
# Example output: "2026-04-08 9AM Meeting Notes"
GOOGLE_DOC_NAME_FORMAT=%Y-%m-%d {time} Meeting Notes

# Path to Google OAuth client secret file (download from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login
GOOGLE_TOKEN_FILE=token.json
